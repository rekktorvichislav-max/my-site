# Copy to .env.local and fill in
JWT_SECRET=generate-a-long-random-string
CLIENT_SECRET=shared-secret-between-site-and-minecraft-client
# Optional: path to the client jar to serve from /api/download
# CLIENT_FILE_PATH=C:\path\to\cotax-client.jar
# Railway: монтируй Volume в /data и ставь путь на него, чтобы БД не сбрасывалась.
DATABASE_PATH=./data/cotax.db

# Ссылки на соцсети (видны в кабинете). Fallback — плейсхолдеры.
NEXT_PUBLIC_SOCIAL_TG=https://t.me/Axion_Client
NEXT_PUBLIC_SOCIAL_DS=https://discord.gg/cotax
